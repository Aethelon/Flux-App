# Server-side backend API base URL
API_URL=http://localhost:3333

# Shared access-token secret; must match Flux-API JWT_ACCESS_SECRET
JWT_SECRET=your_super_secret_jwt_key_here

# Access-token cookie name
JWT_COOKIE_NAME=flux_token

# Refresh-token cookie name and maximum age (default: 30 days)
REFRESH_COOKIE_NAME=flux_refresh_token
REFRESH_COOKIE_MAX_AGE=2592000

NODE_ENV=development
